[run]
omit =
    */tests/*
    */test_*
    *__pycache__*
    */site-packages/*
    */venv/*
    seed_data.py
    alembic/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
